# Server Port (Render automatically assigns PORT)
PORT=5000

# Database Configuration (MSSQL)
DB_HOST=your_mssql_host
DB_USER=your_mssql_user
DB_PASS=your_mssql_password
DB_NAME=your_mssql_database
DB_PORT=1433
DB_DIALECT=mssql

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key

# Email / SMTP Configuration
SMTP_EMAIL=your_email@gmail.com
SMTP_PASS=your_app_specific_password

# CDN / External Uploads
CDN_UPLOAD_URL=https://your-upload-endpoint/api/uploadfile

# Razorpay Keys
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Allowed Frontend URLs for CORS (comma-separated or single)
CLIENT_URL=https://your-frontend.netlify.app
ADMIN_URL=https://your-admin.netlify.app
